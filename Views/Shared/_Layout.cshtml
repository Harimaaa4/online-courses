<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Онлайн курсы</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media_style.css" asp-append-version="true" />
</head>
<body>

    <script>
        (function() {
            const theme = localStorage.getItem('theme');
            if (theme === 'dark') {
                document.body.classList.add('dark-mode');
            }
        })();
    </script>

    <header id="header-top">
        <div class="header-inner">
            <a asp-controller="Home" asp-action="Index" class="logo">Онлайн курсы</a>

            <nav class="main-nav">
                <ul>
                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="@(ViewData["ActivePage"]?.ToString() == "Index" ? "active" : "")">
                            Главная
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Contact"
                           class="@(ViewData["ActivePage"]?.ToString() == "Contact" ? "active" : "")">
                            Контакты
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Courses"
                           class="@(ViewData["ActivePage"]?.ToString() == "Courses" ? "active" : "")">
                            Курсы
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="SiteInformation"
                           class="@(ViewData["ActivePage"]?.ToString() == "SiteInformation" ? "active" : "")">
                            О нас
                        </a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li>
                            <a asp-controller="Cart" asp-action="Index"
                               class="@(ViewData["ActivePage"]?.ToString() == "Cart" ? "active" : "")">
                                Корзина
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="header-right-group">
                <button class="theme-toggle" id="theme-toggle" title="Переключить тему">
                    <span class="icon-sun">☀️</span>
                    <span class="icon-moon">🌙</span>
                </button>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-link text-dark text-decoration-none dropdown-toggle d-flex align-items-center p-0 user-dropdown-btn"
                                type="button"
                                id="dropdownUserMenu"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            @{
                                var avatarUrl = User.FindFirst("AvatarUrl")?.Value ??
                                User.FindFirst("urn:google:picture")?.Value ??
                                "https://github.com/mdo.png";
                            }

                            <img src="@avatarUrl" alt="Avatar" class="user-avatar">
                            <span class="ms-2 fw-bold d-none d-md-inline user-name">@User.Identity.Name</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow custom-dropdown-menu" aria-labelledby="dropdownUserMenu">
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Profile">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="me-2 text-primary">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                    Профиль
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Cart" asp-action="Index">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="me-2 text-success">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                    </svg>
                                    Корзина
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center text-danger" asp-controller="Account" asp-action="Logout">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="me-2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                    Выйти
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="auth-buttons">
                        <button class="button secondary" id="open-login-modal">Войти</button>
                        <button class="button" id="open-register-modal">Зарегистрироваться</button>
                    </div>
                }

                <div class="hamburger-menu" id="hamburger-menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </header>

    <div class="side-menu" id="side-menu">
        <nav class="side-nav">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li><a asp-controller="Home" asp-action="Contact">Контакты</a></li>
                <li><a asp-controller="Home" asp-action="Courses">Курсы</a></li>
                <li><a asp-controller="Home" asp-action="SiteInformation">О нас</a></li>
            </ul>
        </nav>

        <div class="side-auth-buttons">
            @if (User.Identity.IsAuthenticated)
            {
                <div style="text-align: center; margin-bottom: 10px; font-weight: bold;">
                    @User.Identity.Name
                </div>
                <a asp-controller="Home" asp-action="Logout" class="button">Выйти</a>
            }
            else
            {
                <button class="button secondary" id="side-open-login">Войти</button>
                <button class="button" id="side-open-register">Зарегистрироваться</button>
            }
        </div>
    </div>

    <div class="auth-overlay" id="modal-overlay">

        <div class="auth-modal" id="login-modal">
            <span class="auth-modal-close" data-close-modal>&times;</span>
            <h2>Вход</h2>
            <p class="modal-subtitle">Добро пожаловать обратно!</p>

            <form class="auth-form" onsubmit="return false;">
                <div id="login-error-container" class="error-container"></div>
                <input type="email" id="login-email" name="Email" placeholder="Email" required />
                <input type="password" id="login-password" name="Password" placeholder="Пароль" required />
                <button type="submit" id="login-submit-btn" class="button">Войти</button>

                <div class="google-btn-container" style="margin-top: 15px; text-align: center;">
                    <button type="button" class="button secondary" id="google-login-btn" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px;">
                        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.64 9.2c0-.637-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4" fill-rule="evenodd"></path>
                            <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.715H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853" fill-rule="evenodd"></path>
                            <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.448 2.797 1.225 3.95l2.739-2.24z" fill="#FBBC05" fill-rule="evenodd"></path>
                            <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.696 7.14C4.404 5.01 6.388 3.58 9 3.58z" fill="#EA4335" fill-rule="evenodd"></path>
                        </svg>
                        Войти через Google
                    </button>
                </div>
            </form>

            <p class="modal-switch">
                Нет аккаунта?
                <a href="#" data-switch-modal="register-modal">Зарегистрироваться</a>
            </p>
        </div>

        <div class="auth-modal" id="register-modal">
            <span class="auth-modal-close" data-close-modal>&times;</span>
            <h2>Регистрация</h2>
            <p class="modal-subtitle">Создайте аккаунт, это быстро!</p>

            <form class="auth-form" onsubmit="return false;">
                <div id="register-error-container" class="error-container"></div>
                <input type="text" id="register-login" name="Login" placeholder="Ваше имя (Логин)" required />
                <input type="email" id="register-email" name="Email" placeholder="Email" required />
                <input type="password" id="register-password" name="Password" placeholder="Придумайте пароль" required />
                <input type="password" id="register-passwordConfirm" name="PasswordConfirm" placeholder="Повторите пароль" required />
                <button type="submit" id="register-submit-btn" class="button">Создать аккаунт</button>
            </form>

            <p class="modal-switch">
                Уже есть аккаунт?
                <a href="#" data-switch-modal="login-modal">Войти</a>
            </p>
        </div>

        <div class="auth-modal" id="confirm-email-modal">
            <span class="auth-modal-close" data-close-modal>&times;</span>
            <h2>Подтверждение</h2>
            <p class="modal-subtitle">Введите код, отправленный на вашу почту</p>

            <form class="auth-form" onsubmit="return false;">
                <div id="confirm-error-container" class="error-container"></div>

                <input type="hidden" id="confirm-login" />
                <input type="hidden" id="confirm-email" />
                <input type="hidden" id="confirm-password" />
                <input type="hidden" id="confirm-generated-code" />

                <input type="text" id="confirm-code" placeholder="Код из письма" required style="text-align: center; font-size: 1.2rem; letter-spacing: 2px;" />

                <button type="submit" id="confirm-submit-btn" class="button">Подтвердить</button>
            </form>
        </div>

    </div>

    @if (ViewData["ShowHeaderImage"]?.ToString() != "false")
    {
        <img class="img-header" src="~/images/main-banner.jpg" alt="Обложка курсов" />
    }

    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container footer-inner">
            <div class="footer-left">
                <div class="footer-logo">Онлайн курсы</div>
                <p class="footer-text">Обучайтесь с удовольствием — в любое время, в любом месте.</p>
            </div>

            <div class="footer-links">
                <h4>Навигация</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li><a asp-controller="Home" asp-action="SiteInformation">О нас</a></li>
                    <li><a asp-controller="Home" asp-action="Courses">Курсы</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Контакты</a></li>
                </ul>
            </div>

            <div class="footer-contact">
                <h4>Связь</h4>
                <p><strong>Email:</strong> <a href="mailto:info@onlinecourses.ru">info@onlinecourses.ru</a></p>
                <p><strong>Телефон:</strong> <a href="tel:+79991234567">+7 (999) 123-45-67</a></p>
            </div>

            <div class="footer-social">
                <h4>Мы в соцсетях</h4>
                <div class="social-icons">
                    <a href="#" aria-label="VK">VK</a>
                    <a href="#" aria-label="Telegram">TG</a>
                    <a href="#" aria-label="YouTube">YT</a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>© 2025 Онлайн курсы. Все права защищены.</p>
                <p><a asp-controller="Home" asp-action="Privacy">Политика конфиденциальности</a></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/shared_script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>