@model IEnumerable<online_courses.Entities.CourseDb>

@{
    ViewData["Title"] = "Управление курсами";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🎓 Список курсов</h2>
        <a asp-action="CreateCourse" class="btn btn-primary">
            + Добавить курс
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Курсов пока нет.</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Фото</th>
                    <th>Название</th>
                    <th>Цена</th>
                    <th>Автор</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@Url.Content(item.Image)" style="width: 60px; height: 40px; object-fit: cover; border-radius: 4px;" />
                            }
                            else
                            {
                                <span class="text-muted small">Нет</span>
                            }
                        </td>
                        <td class="fw-bold">@item.Name</td>
                        <td>@item.Price.ToString("N0") ₽</td>
                        <td>@item.Author</td>
                        <td class="text-end">
                            <a asp-action="EditCourse" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary me-2" title="Редактировать">
                                ✏️
                            </a>

                            <a asp-action="DeleteCourse" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger" title="Удалить"
                               onclick="return confirm('Вы уверены, что хотите удалить курс «@item.Name»?');">
                                🗑️
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">← Назад в меню</a>
    </div>
</div>