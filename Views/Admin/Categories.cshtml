@model IEnumerable<online_courses.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Категории";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📂 Управление категориями</h2>
        <a asp-action="CreateCategory" class="btn btn-success">+ Добавить категорию</a>
    </div>

    <form asp-action="Categories" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control"
                   placeholder="Поиск по названию..."
                   value="@ViewBag.CurrentFilter">
            <button class="btn btn-primary" type="submit">Найти</button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter as string))
            {
                <a asp-action="Categories" class="btn btn-outline-secondary">Сбросить</a>
            }
        </div>
    </form>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;" class="text-center">Превью</th>
                        <th>Название</th>
                        <th class="text-center">Курсов</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@Url.Content(item.ImagePath)"
                                         class="img-thumbnail"
                                         style="width: 60px; height: 40px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted small">Нет фото</span>
                                }
                            </td>
                            <td class="fw-bold">@item.Name</td>
                            <td class="text-center"><span class="badge bg-secondary">@item.CourseCount</span></td>
                            <td class="text-end pe-3">
                                <a asp-action="EditCategory" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2" title="Редактировать">✏️</a>
                                <a asp-action="DeleteCategory" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Удалить"
                                   onclick="return confirm('Удалить категорию «@item.Name»?');">🗑️</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning mt-3 text-center">Категории не найдены.</div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">← Назад в меню</a>
    </div>
</div>