@model IEnumerable<online_courses.Models.CategoryViewModel>
@{
    ViewData["Title"] = "Управление категориями";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📂 Категории курсов</h2>
        <a asp-action="CreateCategory" class="btn btn-success">
            + Добавить категорию
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Категорий пока нет. Самое время создать первую!
        </div>
    }
    else
    {
        <table class="table table-hover shadow-sm bg-white rounded align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 100px;">Фото</th>
                    <th>Название</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@Url.Content(item.ImagePath)" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                            }
                            else
                            {
                                <span class="text-muted small">Нет фото</span>
                            }
                        </td>
                        <td class="fw-bold">@item.Name</td>
                        <td class="text-end">
                            <a asp-action="EditCategory" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary me-2"
                               title="Редактировать">
                                ✏️
                            </a>

                            <a asp-action="DeleteCategory" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               title="Удалить"
                               onclick="return confirm('Вы уверены, что хотите удалить категорию «@item.Name»?');">
                                🗑️
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">← Назад в меню</a>
    </div>
</div>