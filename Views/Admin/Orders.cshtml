@model IEnumerable<online_courses.Entities.OrderDb>

@{
    ViewData["Title"] = "Заказы";
}

<div class="container mt-5">
    <h2>🛒 История заказов</h2>

    <div class="card shadow mt-4">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Курсы</th>
                        <th>Сумма</th>
                        <th>Дата</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><small>@item.Id.ToString().Substring(0, 8)...</small></td>
                            <td>@item.UserEmail</td>
                            <td>@item.CourseNames</td>
                            <td class="fw-bold">@item.TotalPrice.ToString("N0") ₽</td>
                            <td>@item.CreatedDate.ToLocalTime().ToString("g")</td>
                            <td>
                                <span class="badge bg-success">@item.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3 text-center">Заказов пока нет.</div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">← Назад</a>
    </div>
</div>