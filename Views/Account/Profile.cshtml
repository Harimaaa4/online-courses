@model online_courses.Models.ProfileViewModel

@{
    ViewData["Title"] = "Профиль";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Редактирование профиля</h3>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="https://github.com/mdo.png" alt="Avatar" class="rounded-circle img-thumbnail" style="width: 150px; height: 150px;">
                        }
                    </div>

                    <form asp-action="Profile" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label">Логин</label>
                            <input type="text" class="form-control" value="@Model.Login" disabled readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="text" class="form-control" value="@Model.Email" disabled readonly>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label asp-for="AvatarFile" class="form-label">Загрузить фото</label>
                            <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*">
                            <div class="form-text">Выберите изображение с вашего устройства (JPG, PNG).</div>
                        </div>

                        <div class="text-center my-2 text-muted">- ИЛИ -</div>

                        <div class="mb-3">
                            <label asp-for="AvatarUrl" class="form-label">Ссылка на аватарку</label>
                            <input asp-for="AvatarUrl" class="form-control" placeholder="https://...">
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success">Сохранить изменения</button>
                            <a asp-controller="Home" asp-action="Logout" class="btn btn-outline-danger">Выйти из аккаунта</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>