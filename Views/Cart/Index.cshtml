@model List<online_courses.Models.CartViewModel>

@{
    ViewData["Title"] = "Корзина";
    ViewData["ActivePage"] = "Cart";
}

<div class="text-center" style="margin-top: 50px;">
    <h1 class="display-4">Ваша корзина</h1>
</div>

<div class="container mt-5">
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Ваша корзина пуста. <a asp-controller="Home" asp-action="Courses">Перейти к курсам</a>.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-12 mb-3">
                    <div class="card">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@Url.Content(item.ImagePath)" alt="@item.CourseName"
                                         style="width: 100px; height: 70px; object-fit: cover; margin-right: 20px; border-radius: 5px;">
                                }
                                <div>
                                    <h5 class="card-title">@item.CourseName</h5>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="card-text text-muted mb-1">@item.Description</p>
                                    }
                                    <span class="badge bg-primary">@item.Price ₽</span>
                                </div>
                            </div>

                            <div>
                                <a asp-controller="Cart" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4 d-flex justify-content-center align-items-center gap-3">
            <h3>Итого: @Model.Sum(x => x.Price) ₽</h3>
            <a asp-action="CreateOrder" class="btn btn-success btn-lg">Оформить заказ</a>
        </div>
    }
</div>