@{
    ViewData["Title"] = "Спасибо за покупку!";
}

<div class="container text-center" style="margin-top: 100px; margin-bottom: 100px;">
    <div class="mb-4">
        <div style="width: 80px; height: 80px; background-color: #d4edda; color: #28a745; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-check-lg" viewBox="0 0 16 16">
                <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z" />
            </svg>
        </div>
    </div>

    <h1 class="display-4 fw-bold mb-3">Спасибо за заказ!</h1>
    <p class="lead text-muted mb-5">
        Ваш заказ успешно оформлен. Мы уже начали его обработку.<br />
        Письмо с подтверждением отправлено на вашу почту.
    </p>

    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
        <a asp-controller="Home" asp-action="Courses" class="btn btn-primary btn-lg px-4 gap-3">Вернуться в каталог</a>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary btn-lg px-4">В личный кабинет</a>
    </div>
</div>