@model List<online_courses.Models.CourseViewModel>

@{
    ViewData["Title"] = "Список курсов";
}

<div class="container-section">
    <h2 class="info-section">Доступные курсы</h2>
    <p class="text" style="text-align: center;">Выберите курс для подробного изучения</p>
</div>

<div class="courses-page-container">

    <aside class="filters-sidebar">

        <div class="filter-group">
            <h3>Поиск</h3>
            <input type="text" id="search-input" placeholder="Название курса..."
                   style="width: 100%; padding: 10px; border: 1px solid var(--border-color-input); border-radius: 8px;">
        </div>

        <div class="filter-group">
            <h3>Цена</h3>
            <div class="range-slider">
                <label>От: <span id="price-min-val">0</span> ₽</label>
                <input type="range" id="price-min" min="0" max="10000" step="100" value="0">

                <label>До: <span id="price-max-val">10000</span> ₽</label>
                <input type="range" id="price-max" min="0" max="10000" step="100" value="10000">
            </div>
        </div>

        <div class="filter-group">
            <h3>Уровень</h3>
            <label class="checkbox-container">
                <input type="checkbox" value="Beginner"> Новичок
                <span class="checkmark"></span>
            </label>
            <label class="checkbox-container">
                <input type="checkbox" value="Middle"> Продвинутый
                <span class="checkmark"></span>
            </label>
            <label class="checkbox-container">
                <input type="checkbox" value="Senior"> Профи
                <span class="checkmark"></span>
            </label>
        </div>

        <button class="button" id="apply-filters" style="width: 100%; margin-top: 20px;">Применить</button>
    </aside>

    <div class="courses-content">

        <div class="sorting-bar">
            <span>Сортировать по:</span>
            <select id="sort-order">
                <option value="default">По умолчанию</option>
                <option value="price_asc">Цене (сначала дешевые)</option>
                <option value="price_desc">Цене (сначала дорогие)</option>
                <option value="rating">Рейтингу</option>
            </select>
        </div>

        <div class="courses-list-container">
            @if (Model != null && Model.Any())
            {
                foreach (var course in Model)
                {
                    <div class="course-item">
                        <div class="course-img">
                            <img src="@Url.Content(course.Image)" alt="@course.Name" />
                        </div>
                        <div class="course-details">
                            <h3>@course.Name</h3>
                            <div class="course-meta">
                                <span class="level-badge">@course.Level</span>
                                <span class="rating">⭐ @course.Rating</span>
                            </div>
                            <p class="course-desc">@course.Description</p>
                            <div class="course-footer">
                                <span class="price">@course.Price.ToString("C")</span>
                                <a asp-controller="Home" asp-action="GetCourse" asp-route-id="@course.Id" class="button">Подробнее</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; margin-top: 50px; width: 100%;">
                    <p style="font-size: 1.2rem; color: var(--text-secondary);">В этой категории пока нет курсов.</p>
                    <div style="margin-top: 20px;">
                        <a asp-controller="Home" asp-action="Courses" class="button secondary">Вернуться к категориям</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>