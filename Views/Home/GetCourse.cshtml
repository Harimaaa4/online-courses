@model online_courses.Models.CourseViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="course-details-container">

    <div class="course-header-card">
        <div class="course-img-large">
            <img src="@Url.Content(Model.Image)" alt="@Model.Name" />
        </div>
        <div class="course-info-main">
            <h1>@Model.Name</h1>
            <div class="course-badges">
                <span class="level-badge large">@Model.Level</span>
                <span class="rating large">⭐ @Model.Rating / 5</span>
            </div>
            <p class="price-large">@Model.Price.ToString("C")</p>

            <div class="action-buttons">
                <button class="button big-btn">Записаться на курс</button>
            </div>
        </div>
    </div>

    <div class="course-description-block">
        <h2>О курсе</h2>
        <p class="description-text">
            @Model.Description
        </p>

    </div>

    <div class="back-link">
        <a asp-controller="Home" asp-action="ListCourses" class="button secondary">← Вернуться к списку</a>
    </div>

</div>