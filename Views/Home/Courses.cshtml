@model List<online_courses.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Каталог курсов";
}

<div class="container-section">
    <h2 class="info-section">Категории курсов</h2>
    <p class="text" style="text-align: center;">Выберите направление обучения</p>
</div>

<div class="categories-grid">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <a href="@Url.Action("ListCourses", "Home", new { categoryId = item.Id })" class="category-card">
                <div class="category-img-wrapper">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@Url.Content(item.ImagePath)" alt="@item.Name"
                             style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <div style="width: 100%; height: 100%; background-color: #eee; display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #ccc;">
                            📂
                        </div>
                    }
                </div>
                <div class="category-content">
                    <h3>@item.Name</h3>
                    <p>Курсов: @item.CourseCount</p>
                </div>
            </a>
        }
    }
    else
    {
        <p style="text-align:center; width:100%;">Категории пока не добавлены.</p>
    }
</div>